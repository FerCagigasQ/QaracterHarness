{
  "name": "apolo-cli",
  "version": "0.1.0-alpha.0",
  "description": "APOLO CLI MVP documentation, packaging validation, and integration QA harness.",
  "type": "module",
  "bin": {
    "apolo": "./packaging/bin/apolo.mjs"
  },
  "files": [
    "README.md",
    "docs",
    "examples",
    "packaging/bin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "package:check": "node packaging/validate-npm-package.mjs",
    "test": "node --test test/integration/*.test.mjs",
    "test:python": "python -m unittest discover -s test/harness -p \"test_*.py\"",
    "smoke:bin": "node packaging/smoke-bin.mjs",
    "ci": "npm run typecheck && npm run package:check && npm test && npm run test:python && npm run smoke:bin"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}
